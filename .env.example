# Copy to .env.local and fill in. Never commit real values.

# Canonical origin, no trailing slash (e.g. https://strata.example). Used for
# canonical URLs, Open Graph, sitemap.xml, robots.txt and JSON-LD. Until this or
# COMPANY.url in src/config/company.ts is set, every page is served noindex.
NEXT_PUBLIC_SITE_URL=

# Set to 1 on staging/preview deployments to keep them out of search results.
NEXT_PUBLIC_NOINDEX=

# Where Request demo submissions are forwarded (POST, JSON body).
# Leave empty in development: the form still works locally but nothing is sent.
# In production an empty value makes the form show an error instead of a false "sent".
DEMO_FORM_WEBHOOK_URL=
